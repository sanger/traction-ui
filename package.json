{
  "name": "traction-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:host": "npm-run-all -p serve:css serve:host",
    "start:test": "npm-run-all -p serve:css 'serve -- --mode testing'",
    "start": "npm-run-all -p serve:css serve",
    "serve:host": "vite --host",
    "serve": "vite",
    "build": "npm-run-all build:css build:js",
    "build:js": "vite build",
    "test:unit": "vitest run",
    "test:e2e": "test:e2e:all",
    "test:e2e:all": "npm-run-all -p start:test test:cypress:all",
    "test:e2e:one": "npm-run-all -p start:test test:cypress:one",
    "test:cypress:all": "cypress run",
    "test:cypress:one": "cypress open",
    "lint": "eslint .",
    "format": "prettier --write --list-different '**/*' --ignore-path .prettierignore",
    "pretty": "prettier --check '**/*' --ignore-path .prettierignore",
    "test": "npm-run-all test:unit test:e2e:all",
    "serve:css": "postcss src/styles/tailwind.css -o src/styles/index.css",
    "build:css": "postcss src/styles/tailwind.css -o src/styles/index.css --env production",
    "jsdoc": "./node_modules/.bin/jsdoc -a all -r --configure jsdoc.json --destination docs"
  },
  "dependencies": {
    "@okta/okta-auth-js": "^8.0.1",
    "@okta/okta-vue": "^5.8.0",
    "@sanger/ui-styling": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/devtools-api": "^8.2.1",
    "csv-parse": "^7.0.2",
    "global": "^4.4.0",
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.0",
    "vue": "^3.5.43",
    "vue-router": "^4.0.0",
    "vue3-selecto": "^1.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@vue/test-utils": "^2.5.1",
    "clean-jsdoc-theme": "^5.2.0",
    "cypress": "^15.21.1",
    "cypress-file-upload": "^5.0.8",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^12.0.0",
    "prettier": "3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  }
}
